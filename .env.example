# ===== SmartProperty 部署环境变量模板 =====
# 复制本文件为 .env（docker compose 自动加载），
# 按实际部署环境修改。**生产环境务必替换所有默认值。**

# ===== 时区 =====
TZ=Asia/Shanghai

# ===== MySQL =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
MYSQL_USERNAME=root
# 明文直接生效；如需加密可改写为 ENC(...) 形式
MYSQL_PASSWORD=123456
MYSQL_DATABASE_SYSTEM=smart_property_system
MYSQL_DATABASE_PROPERTY=smart_property_property
MYSQL_DATABASE_OPERATION=smart_property_operation

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DATABASE=0

# ===== Nacos =====
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
# 需与 Nacos 控制台中 nacos 用户的密码保持一致（首次登录控制台时修改）
NACOS_PASSWORD=123456
# v3 服务端鉴权（compose 中间件使用；TOKEN 为 Base64，原文至少 32 字符）
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# ===== RabbitMQ =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=123456
RABBITMQ_VHOST=/

# ===== MinIO =====
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
# MinIO 密钥最少 8 位，123456 仅 6 位会导致容器启动失败
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=smartproperty

# ===== 业务加密（生产环境务必使用 32 字节以上的强随机） =====
SMART_PROPERTY_SECRET_KEY=smart-property-default-secret-key-32bytes-min
ENCRYPT_KEY=ENC(/eTLzR1TrARBRXV/VCzfv4VxM2u3INi2Zzc679ETKAk=)

# ===== JVM / 日志 =====
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
LOG_LEVEL=info

# ===== 文件服务 =====
FILE_UPLOAD_TMP_DIR=/tmp/upload
FILE_URL_BASE=http://minio:9000
